# Copy this file to `.env.local` and fill in the values from
# Supabase Dashboard → Project Settings → API Keys.
# `.env.local` is gitignored — never commit real keys.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_...) or the legacy "anon" key.
# Both are safe to expose in the browser; Row Level Security protects the data.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
